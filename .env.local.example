# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...
# Image model per level (optional — defaults shown). Both need Org verification.
#   L1 情境圖（無文字）／ L2 完稿廣告（含中文，需強文字渲染）
OPENAI_IMAGE_MODEL_L1=gpt-image-1.5
OPENAI_IMAGE_MODEL_L2=gpt-image-2

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=ai-marketing-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (copy generation)
ANTHROPIC_API_KEY=
